@page "/recuperar"

@using DiagnosticoMaquinas.Models
@using DiagnosticoMaquinasWasm.Services

@inject SupabaseService SupabaseService
@inject NavigationManager Nav

<div class="login-container">

    <div class="login-card">

        <h2>RECUPERAR CONTRASEÑA</h2>

        <input class="login-input"
               placeholder="Usuario"
               @bind="Usuario" />

        <input class="login-input"
               placeholder="Correo"
               @bind="Correo" />

        <input class="login-input"
               placeholder="Nueva contraseña"
               type="password"
               @bind="NuevaPassword" />

        <input class="login-input"
               placeholder="Confirmar contraseña"
               type="password"
               @bind="ConfirmarPassword" />

        @if (!string.IsNullOrEmpty(Mensaje))
        {
            <p class="@ClaseMensaje">
                @Mensaje
            </p>
        }

        <button class="btn btn-primary w-100"
                @onclick="SolicitarRecuperacion">
            Restablecer Contraseña
        </button>

        <button class="btn btn-secondary w-100 mt-2"
                @onclick='() => Nav.NavigateTo("/")'>
            Volver al Login
        </button>

    </div>

</div>

@code {

    private string Usuario = "";

    private string Correo = "";

    private string Mensaje = "";

    private string ClaseMensaje = "";

private async Task SolicitarRecuperacion()
{
    if (NuevaPassword != ConfirmarPassword)
    {
        Mensaje = "Las contraseñas no coinciden";
        ClaseMensaje = "mensaje-error";
        return;
    }

    var response =
        await SupabaseService.Client
            .From<Usuario>()
            .Get();

    var usuario =
        response.Models.FirstOrDefault(x =>
            x.UsuarioSistema == Usuario &&
            x.Correo == Correo);

    if (usuario is null)
    {
        Mensaje = "Usuario o correo incorrectos";
        ClaseMensaje = "mensaje-error";
        return;
    }

    usuario.Password = NuevaPassword;

    await SupabaseService.Client
        .From<Usuario>()
        .Update(usuario);

    Mensaje = "Contraseña actualizada correctamente";
    ClaseMensaje = "mensaje-exito";

    Usuario = "";
    Correo = "";
    NuevaPassword = "";
    ConfirmarPassword = "";
}
    private string NuevaPassword = "";

private string ConfirmarPassword = "";
}